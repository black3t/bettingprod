# Casino Mock Platform Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
USE_SQLITE=true
DATABASE_URL=postgresql://user:password@localhost:5432/casino_db

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# API Base Paths
API_BASE_PATH=/casino/api/v1
RGS_BASE_PATH=/rgs/api/v1

# Compatibility Routes (only for dev/test)
COMPAT_ROUTES=true

# Development Seed (only for dev/test)
DEV_SEED=true

# API Keys
RGS_API_KEY=test_rgs_key
CASINO_API_KEY=test_casino_key

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3004,http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info

# Session
SESSION_SECRET=dev-secret-change-in-production
SESSION_TIMEOUT=3600000

# Webhook Configuration
WEBHOOK_FORWARD_URL=http://internal-admin:8080/webhooks
WEBHOOK_TIMEOUT=5000
WEBHOOK_MAX_RETRIES=3