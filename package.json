{
  "name": "casino-mock-platform",
  "version": "1.0.0",
  "description": "Casino Mock Platform for Game Testing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "db:init": "docker-compose up -d",
    "db:migrate": "psql postgresql://casino_admin:casino_pass_2024@localhost:5433/casino_mock -f database/init.sql",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "jest --runInBand --detectOpenHandles --verbose",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "casino",
    "gaming",
    "mock"
  ],
